{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,data/melete_db.json,services/**,auth.js,storage.js,server.js}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
